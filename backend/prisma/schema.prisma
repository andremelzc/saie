// Prisma schema para SAIE (Sistema de Asignación Inteligente de Espacios)
// Especificación técnica basada en el Documento de Modelo de Datos (DMD) - Grupo 6 FISI UNMSM

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS DEL SISTEMA
// ==========================================

enum TipoEspacio {
  AULA_TEORICA
  LABORATORIO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum RolCuenta {
  ALUMNO
  DOCENTE
  COORDINACION_ACADEMICA
  JEFATURA_LABORATORIOS
}

enum EstadoAsignacion {
  VIGENTE
  ESCALADA
  HISTORICA
}

enum TipoAlerta {
  SOFTWARE
  CAPACIDAD
}

enum EstadoAlerta {
  PENDIENTE
  RESUELTA
}

enum TipoIncidencia {
  EQUIPO_NO_OPERATIVO
  SOFTWARE_FALTANTE
  OTRO
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoIncidencia {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum CampoHistorialEspacio {
  SOFTWARE
  PCS_MALOGRADAS
}

enum TipoEventoAuditoria {
  ASIGNACION
  ESCALAMIENTO
  ALERTA
  VERIFICACION
}

// Catálogo de software (Spec 08): deja de ser texto libre en `Espacio` y `Seccion`.
// `SISTEMA_OPERATIVO` es una categoría más del catálogo.
enum CategoriaSoftware {
  SISTEMA_OPERATIVO
  IDE
  LENGUAJE
  BASE_DATOS
  REDES
  SIMULACION
  OFIMATICA
  OTRO
}

enum TipoLicencia {
  LIBRE
  EDUCATIVA
  COMERCIAL
}

// Cómo se compara la versión instalada con la requerida por una sección (Spec 08, §3).
enum ComparacionVersion {
  CUALQUIERA
  EXACTA
  MINIMA
}

// ==========================================
// MODELOS DE ESPACIOS FÍSICOS
// ==========================================

model Espacio {
  id                String      @id @default(uuid())
  identificador     String      // Código o nombre visible (ej. "Aula 201", "Lab 03")
  tipo              TipoEspacio // AULA_TEORICA o LABORATORIO
  pabellon          String      // Ubicación dentro del campus
  piso              Int         // Usado para regla de accesibilidad (prioridad Piso 1)
  aforoNominal      Int         @map("aforo_nominal")
  pcsMalogradas     Int?        @map("pcs_malogradas") // Solo LABORATORIO
  habilitado        Boolean     @default(true) // false = fuera de servicio: el motor no lo asigna
  descripcionUso    String?     @map("descripcion_uso") // Rótulo visual (ej. "Sala de investigación")
  // Distancia en metros hasta el ascensor del pabellón; base de la accesibilidad (HU-04, R-07).
  distanciaAscensor Int?        @map("distancia_ascensor")

  // Relaciones
  espaciosContiguosA  EspacioContiguo[]       @relation("EspacioContiguoA")
  espaciosContiguosB   EspacioContiguo[]       @relation("EspacioContiguoB")
  asignacionesEspacio  AsignacionEspacio[]
  alertas              Alerta[]
  incidencias          Incidencia[]
  historialEspacio     HistorialEspacio[]
  responsables         EspacioResponsable[]
  // Software del catálogo instalado en este espacio (solo LABORATORIO).
  softwareInstaladoCatalogo EspacioSoftware[]

  @@unique([pabellon, identificador])
  @@map("espacios")
}

model EspacioContiguo {
  espacioIdA String  @map("espacio_id_a")
  espacioIdB String  @map("espacio_id_b")

  espacioA   Espacio @relation("EspacioContiguoA", fields: [espacioIdA], references: [id], onDelete: Cascade)
  espacioB   Espacio @relation("EspacioContiguoB", fields: [espacioIdB], references: [id], onDelete: Cascade)

  @@id([espacioIdA, espacioIdB])
  @@map("espacios_contiguos")
}

// ==========================================
// MODELOS ACADÉMICOS Y DE HORARIOS
// ==========================================

model Curso {
  id        String    @id @default(uuid())
  codigo    String    @unique // Código oficial del curso (ej. "2020101")
  nombre    String
  secciones Seccion[]

  @@map("cursos")
}

model Seccion {
  id                      String      @id @default(uuid())
  cursoId                 String      @map("curso_id")
  docenteId               String?     @map("docente_id")
  codigoSeccion           String      @map("codigo_seccion")
  periodo                 String      // ej. "2026-1"
  tipoEspacioRequerido    TipoEspacio @map("tipo_espacio_requerido")

  // Relaciones
  curso        Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  docente      Docente?     @relation(fields: [docenteId], references: [id])
  horarios     Horario[]
  matriculas   Matricula[]
  asignaciones Asignacion[]
  // Requerimientos de software del catálogo.
  softwareRequerido SeccionSoftware[]
  // Solicitudes de software que apuntan a esta sección (Issue 4.29).
  solicitudesSoftware SolicitudSoftware[]

  @@unique([cursoId, codigoSeccion, periodo])
  @@map("secciones")
}

model Horario {
  id         String    @id @default(uuid())
  seccionId  String    @map("seccion_id")
  diaSemana  DiaSemana @map("dia_semana")
  horaInicio String    @map("hora_inicio") // Formato "HH:mm" (ej. "08:00")
  horaFin    String    @map("hora_fin")    // Formato "HH:mm" (ej. "10:00")

  seccion    Seccion   @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@unique([seccionId, diaSemana, horaInicio])
  @@map("horarios")
}

model Matricula {
  id                String  @id @default(uuid())
  alumnoId          String  @map("alumno_id")
  seccionId         String  @map("seccion_id")
  movilidadReducida Boolean @default(false) @map("movilidad_reducida")

  alumno  Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  seccion Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, seccionId])
  @@map("matriculas")
}

// ==========================================
// PERSONAS, SALUD Y AUTENTICACIÓN
// ==========================================

model Alumno {
  id              String       @id @default(uuid())
  codigo          String       @unique // Código de matrícula (ej. "22200101")
  nombre          String
  correo          String
  dni             String?
  fechaNacimiento DateTime?    @map("fecha_nacimiento")
  telefono        String?
  direccion       String?
  cuentaId        String?      @unique @map("cuenta_id")

  // Relaciones
  cuenta      Cuenta?      @relation(fields: [cuentaId], references: [id])
  fichaMedica FichaMedica?
  matriculas  Matricula[]
  vinculacionTelegram VinculacionTelegram?

  @@map("alumnos")
}

model FichaMedica {
  alumnoId           String  @id @map("alumno_id")
  tipoSangre         String? @map("tipo_sangre")
  alergias           String?
  condicionEspecial  String? @map("condicion_especial")
  contactoEmergencia String? @map("contacto_emergencia")
  // El propio alumno declara si tiene una condición que le impide subir a pisos superiores.
  // Al activarlo se propaga a `Matricula.movilidadReducida` para que el motor priorice las
  // aulas del Piso 1 (Spec 03 §2.2). No es una etiqueta de discapacidad: describe un
  // requisito de acceso al espacio, no un diagnóstico.
  condicionAccesible Boolean @default(false) @map("condicion_accesible")

  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@map("fichas_medicas")
}

model Docente {
  id                  String       @id @default(uuid())
  codigoDocente       String       @unique @map("codigo_docente")
  nombre              String
  correoInstitucional String       @map("correo_institucional")
  departamento        String
  cuentaId            String?      @unique @map("cuenta_id")

  // Relaciones
  cuenta              Cuenta?             @relation(fields: [cuentaId], references: [id])
  secciones           Seccion[]
  incidencias         Incidencia[]
  solicitudesSoftware SolicitudSoftware[]

  @@map("docentes")
}

model Cuenta {
  id               String    @id @default(uuid())
  rol              RolCuenta
  usuarioLogin     String    @unique @map("usuario_login")
  claveHash        String    @map("clave_hash")
  debeCambiarClave Boolean   @default(true) @map("debe_cambiar_clave")
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")

  // Relaciones 1:1 opcionales con personas
  alumno               Alumno?
  docente              Docente?
  historialEspacio     HistorialEspacio[]
  espaciosResponsables EspacioResponsable[]
  softwareCreado       Software[]
  softwareRegistrado   EspacioSoftware[]
  solicitudesResueltas SolicitudSoftware[]

  @@map("cuentas")
}

// ==========================================
// MOTOR DE ASIGNACIÓN, ALERTAS E INCIDENCIAS
// ==========================================

model Asignacion {
  id                 String           @id @default(uuid())
  seccionId          String           @map("seccion_id")
  estado             EstadoAsignacion @default(VIGENTE)
  fechaAsignacion    DateTime         @default(now()) @map("fecha_asignacion")
  motivoEscalamiento String?          @map("motivo_escalamiento")
  corridaId          String?          @map("corrida_id")
  huellaEntrada      String?          @map("huella_entrada")

  // Relaciones
  seccion             Seccion                   @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  espacios            AsignacionEspacio[]
  alertasAfectadas    AlertaAsignacionAfectada[]
  incidencias         Incidencia[]
  auditorias          RegistroAuditoria[]

  @@map("asignaciones")
}

model AsignacionEspacio {
  asignacionId String @map("asignacion_id")
  espacioId    String @map("espacio_id")

  asignacion Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  espacio    Espacio    @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@id([asignacionId, espacioId])
  @@map("asignaciones_espacios")
}

model Alerta {
  id             String       @id @default(uuid())
  tipo           TipoAlerta   // SOFTWARE o CAPACIDAD
  espacioId      String       @map("espacio_id")
  motivo         String
  fechaDeteccion DateTime     @default(now()) @map("fecha_deteccion")
  estado         EstadoAlerta @default(PENDIENTE)

  espacio               Espacio                    @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  asignacionesAfectadas AlertaAsignacionAfectada[]
  auditorias            RegistroAuditoria[]

  @@map("alertas")
}

model AlertaAsignacionAfectada {
  alertaId     String @map("alerta_id")
  asignacionId String @map("asignacion_id")

  alerta     Alerta     @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  asignacion Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)

  @@id([alertaId, asignacionId])
  @@map("alertas_asignaciones_afectadas")
}

model Incidencia {
  id                      String              @id @default(uuid())
  docenteId               String              @map("docente_id")
  asignacionId            String              @map("asignacion_id")
  espacioId               String              @map("espacio_id")
  tipo                    TipoIncidencia
  descripcion             String
  prioridad               PrioridadIncidencia @default(MEDIA)
  evidencia               String?
  estado                  EstadoIncidencia    @default(PENDIENTE)
  fechaReporte            DateTime            @default(now()) @map("fecha_reporte")
  identificadorSeguimiento String             @unique @map("identificador_seguimiento")
  comentarioCierre         String?             @map("comentario_cierre")
  fechaCierre              DateTime?           @map("fecha_cierre")

  docente    Docente    @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  asignacion Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  espacio    Espacio    @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@map("incidencias")
}

model HistorialEspacio {
  id            String                @id @default(uuid())
  espacioId     String                @map("espacio_id")
  campo         CampoHistorialEspacio
  valorAnterior String?               @map("valor_anterior")
  valorNuevo    String                @map("valor_nuevo")
  fechaCambio   DateTime              @default(now()) @map("fecha_cambio")
  cuentaId      String                @map("cuenta_id")

  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@map("historial_espacios")
}

model EspacioResponsable {
  cuentaId  String  @map("cuenta_id")
  espacioId String  @map("espacio_id")

  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@id([cuentaId, espacioId])
  @@map("espacios_responsables")
}

model RegistroAuditoria {
  id           String              @id @default(uuid())
  tipoEvento   TipoEventoAuditoria @map("tipo_evento")
  asignacionId String?             @map("asignacion_id")
  alertaId     String?             @map("alerta_id")
  detalle      String
  fechaHora    DateTime            @default(now()) @map("fecha_hora")

  asignacion Asignacion? @relation(fields: [asignacionId], references: [id], onDelete: SetNull)
  alerta     Alerta?     @relation(fields: [alertaId], references: [id], onDelete: SetNull)

  @@map("registros_auditoria")
}

// ==========================================
// AVISOS POR TELEGRAM
// ==========================================

// Telegram no permite escribir a un número: el alumno inicia la conversación con el bot y el
// bot recibe un chat_id que se guarda aquí. Una fila por alumno; la baja la desactiva y una
// nueva vinculación la reactiva (así un alumno nunca tiene dos vinculaciones activas).
model VinculacionTelegram {
  id                 String    @id @default(uuid())
  alumnoId           String    @unique @map("alumno_id")
  chatId             String    @unique @map("chat_id")
  activo             Boolean   @default(true)
  fechaVinculacion   DateTime  @default(now()) @map("fecha_vinculacion")
  fechaBaja          DateTime? @map("fecha_baja")
  // Día (hora de Lima) del último resumen diario enviado; evita duplicarlo si la tarea corre dos veces.
  fechaUltimoResumen DateTime? @map("fecha_ultimo_resumen") @db.Date

  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@map("vinculaciones_telegram")
}

// ==========================================
// CATÁLOGO DE SOFTWARE (Spec 08)
// ==========================================

// Catálogo único de software. La identidad de un software es (nombre, versión): el nombre se
// normaliza igual que en el motor y `version` vacía representa "sin versión declarada".
// La baja es lógica (`activo = false`); nunca se borra una fila que tenga instalaciones o
// requerimientos asociados. `SISTEMA_OPERATIVO` es una categoría más.
model Software {
  id                 String            @id @default(uuid())
  nombre             String // Nombre visible (ej. "Python")
  nombreNormalizado  String            @map("nombre_normalizado") // Clave de comparación del motor
  version            String            @default("") // "" = sin versión declarada
  categoria          CategoriaSoftware
  tipoLicencia       TipoLicencia      @default(LIBRE) @map("tipo_licencia")
  descripcion        String?
  fabricante         String?
  activo             Boolean           @default(true) // false = baja lógica
  creadoPorId        String?           @map("creado_por_id")
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime          @updatedAt @map("fecha_actualizacion")

  creadoPor Cuenta?            @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  espacios  EspacioSoftware[]
  secciones SeccionSoftware[]
  solicitudes SolicitudSoftware[]

  @@unique([nombreNormalizado, version])
  @@index([categoria])
  @@map("software")
}

// Software instalado en un laboratorio. Sustituye a `Espacio.softwareInstalado` (text[]).
model EspacioSoftware {
  espacioId        String   @map("espacio_id")
  softwareId       String   @map("software_id")
  fechaInstalacion DateTime @default(now()) @map("fecha_instalacion")
  registradoPorId  String?  @map("registrado_por_id")

  espacio       Espacio  @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  software      Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  registradoPor Cuenta?  @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@id([espacioId, softwareId])
  @@index([softwareId])
  @@map("espacio_software")
}

// Software requerido por una sección, con la regla de versión declarada. Sustituye a
// `Seccion.stackSoftwareRequerido` (text[]).
model SeccionSoftware {
  seccionId          String             @map("seccion_id")
  softwareId         String             @map("software_id")
  comparacionVersion ComparacionVersion @default(CUALQUIERA) @map("comparacion_version")

  seccion  Seccion  @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  software Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  @@id([seccionId, softwareId])
  @@index([softwareId])
  @@map("seccion_software")
}

// Estado del flujo de solicitudes de software (Spec 08, §2.3).
enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Solicitud de software (Spec 08, §2.3 / Issue 4.29). Un docente propone un software que aún no
// está en el catálogo y Coordinación Académica lo aprueba (crea o vincula la fila en `Software`)
// o lo rechaza con motivo. Aprobar no instala nada: eso sigue siendo un paso aparte de Jefatura.
model SolicitudSoftware {
  id                String          @id @default(uuid())
  docenteId         String          @map("docente_id")
  seccionId         String?         @map("seccion_id")
  nombre            String          // Nombre propuesto (ej. "MATLAB")
  version           String          @default("") // "" = sin versión declarada
  categoria         CategoriaSoftware?
  justificacion     String
  estado            EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud    DateTime        @default(now()) @map("fecha_solicitud")
  resueltaPorId     String?         @map("resuelta_por_id")
  fechaResolucion   DateTime?       @map("fecha_resolucion")
  motivoRechazo     String?         @map("motivo_rechazo") // Obligatorio si estado = RECHAZADA
  softwareId        String?         @map("software_id") // Fila creada o vinculada al aprobar

  docente     Docente  @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  seccion     Seccion? @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  resueltaPor Cuenta?  @relation(fields: [resueltaPorId], references: [id], onDelete: SetNull)
  software    Software? @relation(fields: [softwareId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([docenteId])
  @@map("solicitudes_software")
}
