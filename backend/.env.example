# ==========================================
# SAIE Backend - Variables de Entorno (.env)
# ==========================================

# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Configuración de CORS (origen del frontend)
# Desarrollo local: http://localhost:5173
# Producción (Vercel): https://saie-plum.vercel.app
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------
# Base de Datos (PostgreSQL Local para Desarrollo)
# Usar con docker-compose up -d postgres
# ----------------------------------------------------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/saie_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/saie_dev?schema=public"

# ----------------------------------------------------
# Alternativa: PostgreSQL en Supabase (Producción / Staging)
# ----------------------------------------------------
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----------------------------------------------------
# Autenticación y Seguridad (JWT)
# ----------------------------------------------------
JWT_SECRET="cambiar_por_un_secreto_seguro_en_produccion"
JWT_EXPIRES_IN="8h"

# Periodo académico vigente para el portal de alumno y docente (ej. 2026-1).
# Si se omite, se usa el periodo más reciente cargado en las secciones.
# PERIODO_VIGENTE="2026-1"
