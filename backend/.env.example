# Puerto del servidor Express
PORT=3000

# Conexión directa a Supabase (usada por Prisma para aplicar migraciones)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Conexión mediante Transaction Pooler de Supabase (usada en ejecución por la aplicación)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secreto para la emisión y validación de tokens JWT (4 roles)
JWT_SECRET="tu_clave_secreta_jwt_para_firmar_tokens"
JWT_EXPIRES_IN="8h"