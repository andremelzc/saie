# ==========================================
# SAIE Backend - Variables de Entorno (.env)
# ==========================================

# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Configuración de CORS (origen del frontend)
# Desarrollo local: http://localhost:5173
# Producción (Vercel): https://saie-plum.vercel.app
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------
# Base de Datos (PostgreSQL Local para Desarrollo)
# Usar con docker-compose up -d postgres
# ----------------------------------------------------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/saie_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/saie_dev?schema=public"

# ----------------------------------------------------
# Alternativa: PostgreSQL en Supabase (Producción / Staging)
# ----------------------------------------------------
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----------------------------------------------------
# Autenticación y Seguridad (JWT)
# ----------------------------------------------------
JWT_SECRET="cambiar_por_un_secreto_seguro_en_produccion"
JWT_EXPIRES_IN="8h"

# Periodo académico vigente para el portal de alumno y docente (ej. 2026-1).
# Si se omite, se usa el periodo más reciente cargado en las secciones.
# PERIODO_VIGENTE="2026-1"

# ----------------------------------------------------
# Bot de Telegram (avisos al alumno)
# ----------------------------------------------------
# Token que entrega @BotFather al crear el bot. NUNCA va al repositorio.
# TELEGRAM_BOT_TOKEN=""
# Secreto del webhook: una cadena aleatoria larga (A-Z, a-z, 0-9, _ y -). Telegram lo envía en
# el encabezado X-Telegram-Bot-Api-Secret-Token y el backend rechaza lo que no lo traiga.
# TELEGRAM_WEBHOOK_SECRET=""
# Nombre del bot sin @ (lo usa el portal para armar el enlace https://t.me/<usuario>).
# TELEGRAM_BOT_USERNAME=""
#
# Registrar el webhook (una vez por despliegue; la URL pública es la del backend en Render):
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" #     -d "url=https://<backend>/api/v1/telegram/webhook" #     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"

# ----------------------------------------------------
# Resumen diario de clases por Telegram
# ----------------------------------------------------
# Token de servicio de POST /api/v1/telegram/resumen-diario (comparación en tiempo constante).
# Una cadena aleatoria larga. Debe configurarse igual como secreto del repositorio de GitHub
# (RESUMEN_DIARIO_TOKEN), junto con BACKEND_URL (URL pública del backend), para que el workflow
# .github/workflows/resumen-diario.yml pueda invocarlo.
# RESUMEN_DIARIO_TOKEN=""
#
# ----------------------------------------------------
# Asignación programada (tarea desatendida)
# ----------------------------------------------------
# Token de servicio de POST /api/v1/asignaciones/programada (comparación en tiempo constante).
# Una cadena aleatoria larga. Debe configurarse igual como secreto del repositorio de GitHub
# (ASIGNACION_PROGRAMADA_TOKEN) para que el workflow .github/workflows/asignacion-programada.yml
# dispare la corrida nocturna del periodo vigente.
# ASIGNACION_PROGRAMADA_TOKEN=""
